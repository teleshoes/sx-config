#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use File::ReadBackwards;
use Time::HiRes qw(time);
use List::Util qw(sum);

sub parseEntriesInfo(@);
sub formatInfo($$);
sub readGpsinfoEntries($);
sub metersPerSecondToMPH($);

my $EXEC = basename $0;

my $LOG_DIR = "$ENV{HOME}/.cache/harbour-gpsinfo/harbour-gpsinfo";

my $MILES_PER_KM = 0.62137119;
my $M_PER_S_TO_MPH = $MILES_PER_KM*60.0*60.0/1000.0;

my $DEFAULT_FORMAT_SPEC = ""
  . "cur=%{CUR_SPEED_MPH} mph"
  . " avg=%{AVG_SPEED_MPH} mph"
  . " dur=%{FIX_DURATION_S}s"
  . " dist=%{TOTAL_DIST_MI}mi"
  . "%n"
  ;
my $DEFAULT_CUTOFF_MILLIS = 60000;

my $MODE_INFO = "info";

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC [OPTS]
    -fetch entries from harbour-gps-info logs
    -include only entries within the last ${DEFAULT_CUTOFF_MILLIS}ms
    -assume each entry measures the previous 1.0 seconds
    -calculate CUR_SPEED_MPH:
      -use only the latest entry, regardless of gps fix
      -if no entries exist at all:
        CUR_SPEED_MPH='unknown'
      -if the latest entry has no gps fix+speed:
        CUR_SPEED_MPH='waiting'
      -otherwise, use the latest entry's speed in m/s:
        CUR_SPEED_MPH=<ENTRY_SPEED_M_PER_SEC>*$M_PER_S_TO_MPH
    -calculate FIX_DURATION_S
      -count the number of entries that have a gps fix+speed
        FIX_DURATION_S=<GPS_FIX_ENTRY_COUNT>*1.0
    -calculate AVG_SPEED_MPH:
      -use only entries with a gps fix+speed to take a sum of the speeds
      -if no entries exist at all:
        AVG_SPEED_MPH='unknown'
      -if no entries have gps fix+speed:
        AVG_SPEED_MPH='waiting'
      -otherwise, use the sum of speeds in m/s of entries with a gps fix+speed:
        AVG_SPEED_MPH=<SUM_ENTRY_SPEED_M_PER_SEC>*$M_PER_S_TO_MPH/<FIX_DURATION_S>
    -calculate TOTAL_DIST_MI:
      -use only entries with a gps fix+speed to estimate distance
        TOTAL_DIST_MI=<AVG_SPEED_MPH>*<FIX_DURATION_S>/60/60
    -round all values to the nearest tenth and format as:
      $DEFAULT_FORMAT_SPEC

  $EXEC [OPTS] RECENT_CUTOFF_MILLIS
    same as: $EXEC --cutoff-millis=RECENT_CUTOFF_MILLIS

  $EXEC [OPTS] --cur [RECENT_CUTOFF_MILLIS]
    same as: $EXEC --format='%{CUR_SPEED_MPH}%n' --cutoff=RECENT_CUTOFF_MILLIS

  $EXEC [OPTS] --avg [RECENT_CUTOFF_MILLIS]
    same as: $EXEC --format='%{AVG_SPEED_MPH}%n' --cutoff=RECENT_CUTOFF_MILLIS

  $EXEC [OPTS] --dist [RECENT_CUTOFF_MILLIS]
    same as: $EXEC --format='%{TOTAL_DIST_MI}%n' --cutoff=RECENT_CUTOFF_MILLIS

  OPTS
    -m RECENT_CUTOFF_MILLIS
    --cutoff-millis RECENT_CUTOFF_MILLIS | --cutoff-millis=RECENT_CUTOFF_MILLIS
      include entries within the last RECENT_CUTOFF_MILLIS milliseconds
      default is $DEFAULT_CUTOFF_MILLIS

      RECENT_CUTOFF_MILLIS
        positive integer number of millis to look back for harbour-gpsinfo log entries

    --format FORMAT_SPEC | --format=FORMAT_SPEC
      use FORMAT_SPEC with replacements to print output
      default is $DEFAULT_FORMAT_SPEC

      FORMAT_SPEC
        any string, with the following replacements:
        %%                => a literal '%' character
        %n                => a newline character '\\n'
        %{CUR_SPEED_MPH}  => cur speed in mph rounded to nearest tenth, or unknown/waiting
        %{AVG_SPEED_MPH}  => avg speed in mph rounded to nearest tenth, or unknown/waiting
        %{FIX_DURATION_S} => number of entries since cutoff, assumed to be 1s, with GPS fix+speed
        %{TOTAL_DIST_MI}  => distance calculated as AVG_SPEED_MPH / FIX_DURATION_S, in MPH
";

sub main(@){
  my $opts = {
    cutoffMillis => undef,
    formatSpec   => undef,
  };
  my $mode = $MODE_INFO;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(-m|--cutoff-millis)$/ and @_ > 0 and $_[0] =~ /^\d+$/){
      $$opts{cutoffMillis} = shift @_;
    }elsif($arg =~ /^--cutoff-millis=(\d+)$/){
      $$opts{cutoffMillis} = $1;
    }elsif($arg =~ /^(--format)$/ and @_ > 0){
      $$opts{formatSpec} = shift @_;
    }elsif($arg =~ /^--format=(.+)$/){
      $$opts{formatSpec} = $1;
    }elsif($arg =~ /^(--cur)$/){
      $$opts{formatSpec} = "%{CUR_SPEED_MPH}%n";
    }elsif($arg =~ /^(--avg)$/){
      $$opts{formatSpec} = "%{AVG_SPEED_MPH}%n";
    }elsif($arg =~ /^(--dist)$/){
      $$opts{formatSpec} = "%{TOTAL_DIST_MI}%n";
    }elsif($arg =~ /^(\d+)$/ and not defined $$opts{cutoffMillis}){
      $$opts{cutoffMillis} = $arg;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  $$opts{cutoffMillis} = $DEFAULT_CUTOFF_MILLIS if not defined $$opts{cutoffMillis};
  $$opts{formatSpec} = $DEFAULT_FORMAT_SPEC if not defined $$opts{formatSpec};

  my @entries = readRecentGpsinfoEntries($$opts{cutoffMillis});
  my $info = parseEntriesInfo(@entries);

  print formatInfo($$opts{formatSpec}, $info);
}

sub parseEntriesInfo(@){
  my (@entries) = @_;
  my $info = {
    CUR_SPEED_MPH  => @entries > 0 ? 'waiting' : 'unknown',
    AVG_SPEED_MPH  => @entries > 0 ? 'waiting' : 'unknown',
    FIX_DURATION_S => 0,
    TOTAL_DIST_MI  => 0,
  };

  my $latestEntry = @entries > 0 ? $entries[0] : undef;
  if(defined $latestEntry and defined $$latestEntry{speedMPH}){
    $$info{CUR_SPEED_MPH} = $$latestEntry{speedMPH};
  }

  my $totalSpeedMPH = 0;
  my $countGpsFixEntry = 0;
  for my $entry(@entries){
    if(defined $$entry{speedMPH}){
      $totalSpeedMPH += $$entry{speedMPH};
      $countGpsFixEntry++;
    }
  }

  if($countGpsFixEntry > 0){
    $$info{AVG_SPEED_MPH} = sprintf "%.1f", ($totalSpeedMPH/$countGpsFixEntry);
    $$info{FIX_DURATION_S} = $countGpsFixEntry;
    $$info{TOTAL_DIST_MI} = sprintf "%.1f", $totalSpeedMPH*$countGpsFixEntry/60.0/60.0;
  }

  return $info;
}

sub formatInfo($$){
  my ($formatSpec, $info) = @_;
  my $fmt = $formatSpec;
  $fmt =~ s/&/&amp;/g;
  $fmt =~ s/%%/&boing;/g;
  $fmt =~ s/%n/&nl;/g;
  $fmt =~ s/%\{CUR_SPEED_MPH\}/$$info{CUR_SPEED_MPH}/g;
  $fmt =~ s/%\{AVG_SPEED_MPH\}/$$info{AVG_SPEED_MPH}/g;
  $fmt =~ s/%\{FIX_DURATION_S\}/$$info{FIX_DURATION_S}/g;
  $fmt =~ s/%\{TOTAL_DIST_MI\}/$$info{TOTAL_DIST_MI}/g;
  $fmt =~ s/&nl;/\n/g;
  $fmt =~ s/&boing;/%/g;
  $fmt =~ s/&amp;/&/g;
  return $fmt;
}

sub readRecentGpsinfoEntries($){
  my ($cutoffMillis) = @_;
  my $cutoffEpochMillis = int(time * 1000.0) - $cutoffMillis;

  my @allLogFiles = grep {-f $_} glob "$LOG_DIR/*.log";

  #sort by filename epoch
  my %validLogFilesByEpochMillis;
  for my $logFile(@allLogFiles){
    if($logFile =~ /harbour-gpsinfo-(\d+)\.log$/){
      my $epochMillis = $1;
      $validLogFilesByEpochMillis{$epochMillis} = $logFile;
    }
  }

  my @recentLogFiles;
  for my $logEpochMillis(reverse sort keys %validLogFilesByEpochMillis){
    #include all files at or after the cutoff,
    #  plus the last file /older/ than the cutoff,
    #  but exclude any older than that last file
    my $logFile = $validLogFilesByEpochMillis{$logEpochMillis};
    push @recentLogFiles, $logFile;
    if($logEpochMillis < $cutoffEpochMillis){
      last;
    }
  }

  my @entries;
  for my $logFile(@recentLogFiles){
    my $logBwH = File::ReadBackwards->new($logFile)
      or die "ERROR: could not read $logFile\n$!\n";
    my $lastLineTooOld = 0;
    while(!$lastLineTooOld && !$logBwH->eof()){
      my $line = $logBwH->readline();

      if($line =~ /
        ^
        (?<epochMillis>\d+)
        \s*,\s*
        \d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\d
        \s*,\s*
          lat     = (?<lat>[^,]*)
        , lon     = (?<lon>[^,]*)
        , alt     = (?<alt>[^,]*)
        , speed   = (?<speed>[^,]*)
        , dirMove = (?<dirMove>[^,]*)
        , dirComp = (?<dirComp>[^,]*)
        , vAcc    = (?<vAcc>[^,]*)
        , hAcc    = (?<hAcc>[^,]*)
        , sat     = (?<sat>[^,]*)
        $
      /x){
        my $entry = { %+ };
        if($$entry{speed} =~ /^(\d+|\d*\.\d+)m\/s$/){
          $$entry{speedMPH} = metersPerSecondToMPH($1);
        }

        if($$entry{epochMillis} < $cutoffEpochMillis){
          $lastLineTooOld = 1;
        }else{
          push @entries, $entry;
        }
      }
    }
    $logBwH->close();
  }

  return @entries;
}

sub metersPerSecondToMPH($){
  my ($metersPerSecond) = @_;
  if(defined $metersPerSecond and $metersPerSecond =~ /^(\d+|\d*\.\d*)$/){
    my $mph = $metersPerSecond*60.0*60.0 * $MILES_PER_KM/1000.0;
    return $mph;
  }else{
    return undef;
  }
}

&main(@ARGV);
