#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use Time::HiRes qw(time);

sub readLatestGpsLog();

my $EXEC = basename $0;

my $LOG_DIR = "$ENV{HOME}/.cache/harbour-gpsinfo/harbour-gpsinfo";

my $MILES_PER_KM = 0.62137119;
my $THRESHOLD_MILLIS = 60000;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC
    read last speed from harbour-gpsinfo logs and format as MPH
      -parse latest TIMESTAMP and GROUND_SPEED_M_PER_S (in m/s)
      -if no log exists or TIMESTAMP is older than $THRESHOLD_MILLIS ms ago:
        -print '???? MPH'
      -if GROUND_SPEED_M_PER_S is not a real number:
        -print '---- MPH'
      -otherwise:
        -convert GROUND_SPEED_M_PER_S to GROUND_SPEED_MPH, rounded to the nearest tenth
        -print '<GROUND_SPEED_MPH> MPH'
";

sub main(@){
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  my $entry = readLatestGpsLog();

  my $epochMillis = defined $entry ? $$entry{epochMillis} : undef;
  my $nowEpochMillis = int(time * 1000.0);
  my $dateInvalid = 0;
  $dateInvalid = 1 if not defined $epochMillis;
  $dateInvalid = 1 if $epochMillis > $nowEpochMillis + 1000;
  $dateInvalid = 1 if $nowEpochMillis - $epochMillis > $THRESHOLD_MILLIS;

  my $speedMPerS = $$entry{speed} =~ /^(\d+|\d*\.\d+)m\/s$/ ? $1 : undef;
  my $speedMPH = defined $speedMPerS ? metersPerSecondToMPH($speedMPerS) : undef;

  if($dateInvalid){
    print "???? MPH\n";
  }elsif(not defined $speedMPH){
    print "---- MPH\n";
  }else{
    printf "%4.1f MPH\n", $speedMPH;
  }
}

sub readLatestGpsLog(){
  my @logFiles = sort grep {-f $_} glob "$LOG_DIR/*.log";
  if(@logFiles == 0){
    return undef;
  }

  my $lastFile = $logFiles[-1];
  my $lastLine = `tail -1 $lastFile`;
  if($lastLine =~ /
    ^
    (?<epochMillis>\d+)
    \s*:\s*
    \d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\d
    \s*:\s*
      lat     = (?<lat>[^,]*)
    , lon     = (?<lon>[^,]*)
    , alt     = (?<alt>[^,]*)
    , speed   = (?<speed>[^,]*)
    , dirMove = (?<dirMove>[^,]*)
    , dirComp = (?<dirComp>[^,]*)
    , vAcc    = (?<vAcc>[^,]*)
    , hAcc    = (?<hAcc>[^,]*)
    , sat     = (?<sat>[^,]*)
    $
  /x){
    my $entry = { %+ };
    return $entry;
  }else{
    return undef;
  }
}

sub timestampToEpoch($){
  my ($dtmStr) = @_;
  if(not defined $dtmStr or $dtmStr eq ""){
    return undef;
  }

  my $epoch = `date --date='$dtmStr' +%s`;
  chomp $epoch;

  if($epoch =~ /^\d+$/){
    return $epoch;
  }else{
    return undef;
  }
}

sub metersPerSecondToMPH($){
  my ($metersPerSecond) = @_;
  if(defined $metersPerSecond and $metersPerSecond =~ /^(\d+|\d*\.\d*)$/){
    my $mph = $metersPerSecond*$MILES_PER_KM*1000.0/60.0/60.0;
    return $mph;
  }else{
    return undef;
  }
}

&main(@ARGV);
