#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use File::ReadBackwards;
use Time::HiRes qw(time);
use List::Util qw(sum);

sub readGpsinfoEntries($);
sub metersPerSecondToMPH($);

my $EXEC = basename $0;

my $LOG_DIR = "$ENV{HOME}/.cache/harbour-gpsinfo/harbour-gpsinfo";

my $MILES_PER_KM = 0.62137119;
my $DEFAULT_CUTOFF_MILLIS = 60000;

my $MODE_CUR = "cur";
my $MODE_AVG = "avg";

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC [OPTS]
  $EXEC [OPTS] --cur
    read last speed from harbour-gpsinfo logs
      -parse latest TIMESTAMP and GROUND_SPEED_M_PER_S (in m/s)
      -if no log exists or TIMESTAMP is older than $DEFAULT_CUTOFF_MILLIS ms ago:
        -print '???? MPH'
      -if GROUND_SPEED_M_PER_S is not a real number:
        -print '---- MPH'
      -otherwise:
        -convert GROUND_SPEED_M_PER_S to GROUND_SPEED_MPH, rounded to the nearest tenth
        -print '<GROUND_SPEED_MPH> MPH'

  $EXEC [OPTS] --avg
    same as: $EXEC --avg $DEFAULT_CUTOFF_MILLIS

  $EXEC [OPTS] --avg RECENT_CUTOFF_MILLIS
    read all speed readings from harbour-gpsinfo logs from the last RECENT_CUTOFF_MILLIS ms
      -if no recent readings are found:
        -print '???? MPH'
      -otherwise:
        -extract GROUND_SPEED_M_PER_S for each entry as in $EXEC --cur
        -if no readings have defined GROUND_SPEED_M_PER_S:
          -print '---- MPH'
        -otherwise:
          -assume each reading was for 1s and take the mean as AVG_SPEED_M_PER_S
          -convert AVG_SPEED_M_PER_S to AVG_SPEED_MPH, rounded to the nearest tenth
          -print '<AVG_SPEED_MPH> MPH'

  OPTS
    --short
      -print 'unknown' instead of '???? MPH'
      -print 'waiting' instead of '---- MPH'
      -print '<SPEED_MPH>' instead of '<SPEED_MPH> MPH'
";

sub main(@){
  my $opts = {
    isShort => 0,
  };
  my $mode = $MODE_CUR;
  my $cutoffMillis = $DEFAULT_CUTOFF_MILLIS;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(--cur)$/){
      $mode = $MODE_CUR;
    }elsif($arg =~ /^(--avg)$/ and @_ > 0 and $_[0] =~ /^\d+$/){
      $mode = $MODE_AVG;
      $cutoffMillis = shift;
    }elsif($arg =~ /^(--avg)$/){
      $mode = $MODE_AVG;
    }elsif($arg =~ /^(--short)$/){
      $$opts{short} = 1;
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  my @entries = readRecentGpsinfoEntries($cutoffMillis);
  if($mode eq $MODE_CUR and @entries > 0){
    # ignore all entries except the most recent
    @entries = ($entries[0]);
  }
  my @speedEntries = grep {defined $$_{speedMPH}} @entries;

  if(@entries == 0){
    #harbour-gpsinfo is not logging
    print $$opts{short} ? "unknown\n" : "???? MPH\n";
  }elsif(@speedEntries == 0){
    #harbour-gpsinfo is logging, but has no gps fix
    print $$opts{short} ? "waiting\n" : "---- MPH\n";
  }else{
    my @speedMPHs = map {$$_{speedMPH}} @speedEntries;
    my $count = @speedMPHs;
    if($count > 1 and $mode eq $MODE_CUR){
      die "ERROR: too many entries returned for mode=$mode\n";
    }elsif($count == 0){
      die "ERROR: no entries returned for mode=$mode\n";
    }
    my $avgSpeedMPH = sum(@speedMPHs) / $count;
    my $speedFmt = sprintf "%4.1f", $avgSpeedMPH;
    print $$opts{short} ? "$speedFmt\n" : "$speedFmt MPH\n";
  }
}

sub readRecentGpsinfoEntries($){
  my ($cutoffMillis) = @_;
  my $cutoffEpochMillis = int(time * 1000.0) - $cutoffMillis;

  my @allLogFiles = grep {-f $_} glob "$LOG_DIR/*.log";

  #sort by filename epoch
  my %validLogFilesByEpochMillis;
  for my $logFile(@allLogFiles){
    if($logFile =~ /harbour-gpsinfo-(\d+)\.log$/){
      my $epochMillis = $1;
      $validLogFilesByEpochMillis{$epochMillis} = $logFile;
    }
  }

  my @recentLogFiles;
  for my $logEpochMillis(reverse sort keys %validLogFilesByEpochMillis){
    #include all files at or after the cutoff,
    #  plus the last file /older/ than the cutoff,
    #  but exclude any older than that last file
    my $logFile = $validLogFilesByEpochMillis{$logEpochMillis};
    push @recentLogFiles, $logFile;
    if($logEpochMillis < $cutoffEpochMillis){
      last;
    }
  }

  my @entries;
  for my $logFile(@recentLogFiles){
    my $logBwH = File::ReadBackwards->new($logFile)
      or die "ERROR: could not read $logFile\n$!\n";
    my $lastLineTooOld = 0;
    while(!$lastLineTooOld && !$logBwH->eof()){
      my $line = $logBwH->readline();

      if($line =~ /
        ^
        (?<epochMillis>\d+)
        \s*:\s*
        \d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\d
        \s*:\s*
          lat     = (?<lat>[^,]*)
        , lon     = (?<lon>[^,]*)
        , alt     = (?<alt>[^,]*)
        , speed   = (?<speed>[^,]*)
        , dirMove = (?<dirMove>[^,]*)
        , dirComp = (?<dirComp>[^,]*)
        , vAcc    = (?<vAcc>[^,]*)
        , hAcc    = (?<hAcc>[^,]*)
        , sat     = (?<sat>[^,]*)
        $
      /x){
        my $entry = { %+ };
        if($$entry{speed} =~ /^(\d+|\d*\.\d+)m\/s$/){
          $$entry{speedMPH} = metersPerSecondToMPH($1);
        }

        if($$entry{epochMillis} < $cutoffEpochMillis){
          $lastLineTooOld = 1;
        }else{
          push @entries, $entry;
        }
      }
    }
    $logBwH->close();
  }

  return @entries;
}

sub metersPerSecondToMPH($){
  my ($metersPerSecond) = @_;
  if(defined $metersPerSecond and $metersPerSecond =~ /^(\d+|\d*\.\d*)$/){
    my $mph = $metersPerSecond*60.0*60.0 * $MILES_PER_KM/1000.0;
    return $mph;
  }else{
    return undef;
  }
}

&main(@ARGV);
