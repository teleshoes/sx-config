#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);

sub getState();
sub isRunning();

my $EXEC = basename $0;
my $INTENT = 'org.coolreader/.CoolReader';

my $USER = "nemo";

my $CR_DATA_DIR = "/home/.appsupport/instance/$USER/data/data/org.coolreader";
my $CR_STATE_LOG_FILE = "$CR_DATA_DIR/files/cr-state-log.txt";

my $CMDS = {
  next    => "ad shell am start -n $INTENT -a org.coolreader.cmd.PAGE_DOWN",
  prev    => "ad shell am start -n $INTENT -a org.coolreader.cmd.PAGE_UP",
  ttsInit => "ad shell am start -n $INTENT -a org.coolreader.cmd.TTS_PLAY",
  ttsPlay => "ad shell am broadcast -a org.coolreader.tts.tts_play",
  ttsPause => "ad shell am broadcast -a org.coolreader.tts.tts_pause",
  ttsPlayPause => "ad shell am broadcast -a org.coolreader.tts.tts_play_pause",
  toggleOrientation => "ad shell am start -n $INTENT -a org.coolreader.cmd.TOGGLE_ORIENTATION",
};

my $MODE_GET = "get";
my $MODE_CMD = "cmd";

my $STATE_CR3_OFF = "CR3_OFF";
my $STATE_TTS_OFF = "TTS_OFF";
my $STATE_TTS_PLAY = "TTS_PLAY";
my $STATE_TTS_PAUSE = "TTS_PAUSE";

my $USAGE = "Usage:
  $0 -h|--help
    show this message

  $0 get | -g | --get
    if coolreader is not running:
      print: $STATE_CR3_OFF
    if tts is enabled but pause:
      print: $STATE_TTS_PAUSE
    if tts is enabled and playing:
      print: $STATE_TTS_PLAY
    if tts is not enabled:
      print: $STATE_TTS_OFF

  $0 next | --next | --page-down
    if coolreader is running:
      $$CMDS{next}

  $0 prev | --prev | --page-up
    if coolreader is running:
      $$CMDS{prev}

  $0 ttsInit | --tts-init
    if coolreader is running:
      $$CMDS{ttsInit}

  $0 ttsPlay | --tts-play
    if coolreader is running:
      $$CMDS{ttsPlay}

  $0 ttsPause | --tts-pause
    if coolreader is running:
      $$CMDS{ttsPause}

  $0 ttsPlayPause | --tts-play-pause
    if coolreader is running:
      $$CMDS{ttsPlayPause}

  $0 toggleOrientation | --toggle-orientation
    if coolreader is running:
      $$CMDS{toggleOrientation}
";

sub isRunning();

sub main(@){
  my $mode = $MODE_CMD;
  my $cmd = undef;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg =~ /^(get|-g|--get)$/){
      $mode = $MODE_GET;
    }elsif($arg =~ /^(next|--next|--page-down)$/){
      $cmd = $$CMDS{next};
    }elsif($arg =~ /^(prev|--prev|--page-up)$/){
      $cmd = $$CMDS{prev};
    }elsif($arg =~ /^(ttsInit|--tts-init)$/){
      $cmd = $$CMDS{ttsInit};
    }elsif($arg =~ /^(ttsPlay|--tts-play)$/){
      $cmd = $$CMDS{ttsPlay};
    }elsif($arg =~ /^(ttsPause|--tts-pause)$/){
      $cmd = $$CMDS{ttsPause};
    }elsif($arg =~ /^(ttsPlayPause|--tts-playPause)$/){
      $cmd = $$CMDS{ttsPlayPause};
    }elsif($arg =~ /^(toggleOrientation|--toggle-orientation)$/){
      $cmd = $$CMDS{toggleOrientation};
    }else{
      die "$USAGE\nERROR: unknown arg $arg\n";
    }
  }

  if($mode eq $MODE_GET){
    my $state = getState();
    print "$state\n";
  }elsif($mode eq $MODE_CMD){
    if(not defined $cmd){
      die "$USAGE\nERROR: no command given\n";
    }

    if(isRunning()){
      system $cmd;
    }else{
      print "coolreader is not running\n";
    }
  }else{
    die "ERROR: unknown mode $mode\n";
  }
}

sub getState(){
  if(not isRunning()){
    return $STATE_CR3_OFF;
  }

  my @lines = `sudo cat $CR_STATE_LOG_FILE 2>/dev/null`;
  for my $line(reverse @lines){
    if($line =~ /TTS_ON/){
      return $STATE_TTS_PAUSE; #started but not playing
    }elsif($line =~ /TTS_PLAY/){
      return $STATE_TTS_PLAY;
    }elsif($line =~ /TTS_PAUSE/){
      return $STATE_TTS_PAUSE;
    }elsif($line =~ /TTS_OFF/){
      return $STATE_TTS_OFF;
    }
  }
  return $STATE_TTS_OFF;
}

sub isRunning(){
  my $pid = `pgrep '^org.coolreader\$'`;
  chomp $pid;
  return $pid =~ /^\d+$/ ? 1 : 0;
}

&main(@ARGV);
