#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(basename);
use Time::HiRes qw(time);
use POSIX qw(setsid);

sub forkAndStartApp();
sub isAppDbusAvail();
sub startReadingText($);
sub invokeAction($$);
sub getProp($);
sub daemonize();
sub readProc(@);
sub run(@);
sub nowMillis();

my $DBUS_SERVICE = "org.mkiol.dsnote";
my $DBUS_PATH = "/org/mkiol/dsnote";
my $DBUS_METHOD_INVOKE_ACTION = "org.mkiol.dsnote.InvokeAction";
my $DBUS_METHOD_GET_PROP = "org.freedesktop.DBus.Properties.Get";

my $LOG_DIR = "$ENV{HOME}/.cache/logs/tts";

my $EXEC = basename $0;

my $USAGE = "Usage:
  $EXEC -h|--help
    show this message

  $EXEC TEXT_WORD [TEXT_WORD TEXT_WORD..]
    daemonize and run harbour-dsnote
      -double-fork, redirect i/o, etc
      -redirect stdout+stderr to a log file at:
        $LOG_DIR/tts-<NOW_MILLIS>.log
      -format TEXT as \"TEXT_WORD TEXT_WORD TEXT_WORD\"
      -run:
        harbour-dsnote --action start-reading-text --text TEXT
";

sub main(@){
  my @textWords;
  while(@_ > 0){
    my $arg = shift;
    if($arg =~ /^(-h|--help)$/){
      print $USAGE;
      exit 0;
    }elsif($arg !~ /^-/){
      @textWords = ($arg, @_);
      @_ = ();
    }else{
      die "ERROR: unknown arg $arg\n";
    }
  }

  die "$USAGE\nERROR: missing TEXT_WORD\n" if @textWords == 0;

  if(!isAppDbusAvail()){
    #do not rely on DBUS auto-start, there needs to be a longer delay after startup
    print "dbus service not available, starting app and waiting 3s\n";
    forkAndStartApp();
    sleep 3;
  }

  startReadingText("@textWords");
}

sub forkAndStartApp(){
  my $pid = fork();
  die "ERROR: fork failed\n$!\n" if not defined $pid;
  if($pid == 0){
    my $nowMillis = nowMillis();
    my $logFile = "$LOG_DIR/tts-$nowMillis.log";
    print "starting harbour-dsnote app with log file: $logFile\n";

    system "mkdir", "-p", $LOG_DIR if not -d $LOG_DIR;

    open STDOUT, '>>', $logFile;
    open STDERR, '>&STDOUT';

    daemonize();
    exec "harbour-dsnote";
  }
}

sub isAppDbusAvail(){
  my $out = `busctl --user status $DBUS_SERVICE 2>&1`;
  if($out =~ /PID=/){
    return 1;
  }else{
    return 0;
  }
}

sub startReadingText($){
  my ($text) = @_;
  invokeAction('start-reading-text', {"text" => $text});
}

sub invokeAction($$){
  my ($action, $params) = @_;
  my @paramsFmt;
  for my $key(sort keys %$params){
    my $val = $$params{$key};
    $val =~ s/(['"<>\\])/\\$1/g;
    push @paramsFmt, "'$key': <'$val'>";
  }
  my $paramsQvarMap = "{" . join(",", @paramsFmt) . "}";

  run "gdbus", "call",
    "--session",
    "--dest", $DBUS_SERVICE,
    "--object-path", $DBUS_PATH,
    "--method", $DBUS_METHOD_INVOKE_ACTION,
    $action,
    $paramsQvarMap,
  ;
}

sub getProp($){
  my ($prop) = @_;
  return readProc "gdbus", "call",
    "--session",
    "--dest", $DBUS_SERVICE,
    "--object-path", $DBUS_PATH,
    "--method", $DBUS_METHOD_GET_PROP,
    $DBUS_SERVICE,
    $prop,
  ;
}

sub daemonize(){
  my $pid;

  $pid = fork;
  die "ERROR: fork failed\n$!\n" if not defined $pid;
  exit if $pid;

  setsid() or die "ERROR: setsid failed\n$!\n";

  $pid = fork;
  die "ERROR: fork failed\n$!\n" if not defined $pid;
  exit if $pid;

  chdir "/";
  umask 0;

  open STDIN, '<', '/dev/null' or die "ERROR: redirect stdin failed\n$!\n";
  open STDOUT, '>', '/dev/null' or die "ERROR: redirect stdout failed\n$!\n";
  open STDERR, '>&STDOUT' or die "ERROR: redirect stderr failed\n$!\n";
}

sub readProc(@){
  my @cmd = @_;
  open my $cmdH, "-|", @cmd or die "ERROR: could not run @_\n$!\n";
  my @lines = <$cmdH>;
  close $cmdH;
  if(wantarray){
    return @lines;
  }else{
    return join '', @lines;
  }
}

sub run(@){
  print "@_\n";
  system @_;
}

sub nowMillis(){
  return int(time * 1000.0);
}

&main(@ARGV);
