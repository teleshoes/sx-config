#!/usr/bin/perl
use strict;
use warnings;
use lib `dirname $0 | tr -d '\n'`;
use PhoneBackupUtils;

my $IPMAGIC_NAME = "sx";
my $USER = "nemo";

my $GSETTINGS_SCHEMA = "org.freedesktop.Tracker3.Miner.Files";
my $GSETTINGS = {
  'index-removable-devices'     => 'false',
};

my @DIRS_SINGLE = (
  "/home/$USER/Documents",
  "/home/$USER/Downloads",
  "/home/$USER/Pictures",
  "/home/$USER/Videos",

  "/home/$USER/android_storage/Documents",
  "/home/$USER/android_storage/Download",
  "/home/$USER/android_storage/Pictures",
  "/home/$USER/android_storage/Movies",

  "/media/sdcard/droid/DCIM/AndroidCamera/",
  "/media/sdcard/phone/Pictures/Camera/",
  "/media/sdcard/phone/Videos/Camera/",
);

my @DIRS_RECURSIVE = (
);

sub main(@){
  my @cmds;

  for my $key(sort keys %$GSETTINGS){
    my $val = $$GSETTINGS{$key};
    push @cmds, "gsettings set '$GSETTINGS_SCHEMA' '$key' '$val'";
  }

  for my $dir(@DIRS_SINGLE){
    push @cmds, "localsearch index --add '$dir'";
  }
  for my $dir(@DIRS_RECURSIVE){
    push @cmds, "localsearch index --add --recursive '$dir'";
  }

  push @cmds, "localsearch reset -s";
  push @cmds, "localsearch daemon -t";
  push @cmds, "localsearch daemon -s";

  my $cmd = join '', map {"$_;\n"} @cmds;

  run "ipmagic", $IPMAGIC_NAME, "-u", $USER, "-s", $cmd;
}

&main(@ARGV);
