#!/usr/bin/perl
use strict;
use warnings;
use File::Basename qw(dirname);

my $IPMAGIC_NAME = "sx";

my $USER = "nemo";

sub run(@);

my @SYMLINKS_ARR = (
  "1qtemail" => {
    src => "/media/sdcard/phone/email",
    dest => "/home/$USER/.cache/email",
  },
  "2alarms" => {
    src => "/media/sdcard/phone/alarms",
    dest => "/usr/share/alarms",
  },
  "3sounds" => {
    src => "/media/sdcard/phone/sounds",
    dest => "/usr/share/sounds/custom",
  },
  "4klomp" => {
    src => "/media/sdcard/phone/klomp",
    dest => "/home/$USER/.klomp",
  },
  "5bashrc" => {
    src => ".bashrc",
    dest => "/home/$USER.profile",
  },
  "6vnclib" => {
    src => "libvncserver.so.1",
    dest => "/usr/lib64/libvncserver.so.0",
  },
  "7rootbin" => {
    src => "/home/$USER/bin/",
    dest => "/root/bin",
  },
);
my %SYMLINKS = @SYMLINKS_ARR;
my @SYMLINK_NAMES = map {$SYMLINKS_ARR[$_]} grep {$_ % 2 == 0} (0..$#SYMLINKS_ARR);
my %DIR = map {$_ => $SYMLINKS{$_}{dir}} @SYMLINK_NAMES;
my %SRC = map {$_ => $SYMLINKS{$_}{src}} @SYMLINK_NAMES;
my %DEST = map {$_ => $SYMLINKS{$_}{dest}} @SYMLINK_NAMES;

my $SYMLINKS_FMT = join '', map {"    $_: $SRC{$_} => $DEST{$_}\n"} @SYMLINK_NAMES;

my $USAGE = "Usage:
  $0 [SYMLINK_NAME ..]
    set up symlinks for the indicated symlink names
      (default is to set up all if none are given)

    \n$SYMLINKS_FMT
";

sub main(@){
  die $USAGE if @_ == 1 and $_[0] =~ /^(-h|--help)$/;

  my @commands;

  my @names = @_;
  @names = @SYMLINK_NAMES if @_ == 0;
  for my $name(@names){
    die "$USAGE\n\nunknown symlink name: $name\n" if not defined $SYMLINKS{$name};
    my $sym = $SYMLINKS{$name};

    my $src = "$$sym{src}";
    my $dest = "$$sym{dest}";
    my $destDir = dirname $dest;
    my $cmd = "rmdir $dest 2>/dev/null ; rm -f $dest && ln -s $src $dest";

    my $ipmagicUser;
    if($destDir =~ /^\/home\/(\w+)(?:\/.*)?$/){
      $ipmagicUser = "$1";
    }else{
      $ipmagicUser = "root";
    }

    run "ipmagic", $IPMAGIC_NAME, "-u", $ipmagicUser, "sh -c \"$cmd\"";
  }
}

sub run(@){
  print "@_\n";
  system @_;
}

&main(@ARGV);
